# ==============================================================================
# INNER MIRROR BLISS BY DEEPIKA - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# Fill in real production values in deployment settings (e.g., Vercel / Cloudflare).
# NEVER commit .env.local or expose service role keys to the browser.
# ==============================================================================

# Supabase Public Configuration (Accessible in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Configuration (Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
BOOKING_NOTIFICATION_EMAIL=innermirrorbliss@gmail.com

# Site & Domain Configuration
NEXT_PUBLIC_SITE_URL=https://innermirrorbliss.com

# Analytics & Tracking
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
